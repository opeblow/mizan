# Copy to .env only if you need to change something. The local demo needs no settings.

# --- API
# API_PORT=8787
# API_HOST=127.0.0.1
# SESSION_SECRET=change-me-to-a-long-random-string
# DEMO_MODE=true
# DEVICE_ENROLL_TOKEN=mizan-dev-enroll-token

# --- Chain the API writes to (defaults: local Hardhat node)
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# PUBLIC_RPC_URL=http://127.0.0.1:8545
# EXPLORER_URL=

# --- Public testnet (see SETUP.md §5). Use throwaway keys only.
# DEPLOYER_PRIVATE_KEY=0x...
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ORACLE_PRIVATE_KEY=0x...
# VERIFIER_PRIVATE_KEY=0x...
# AUTHORITY_PRIVATE_KEY=0x...
# IMPORTER_A_PRIVATE_KEY=0x...
# IMPORTER_B_PRIVATE_KEY=0x...

# --- Simulator
# BACKFILL_DAYS=10
# REPLAY_DAYS=3
# SIM_SPEED=450
